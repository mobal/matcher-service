APP_NAME=matcher-service
APP_VERSION=1.0.0
AUTH_JWT_ISSUER=dev-auth-service
AUTH_JWT_AUDIENCE=https://dev-matcher-service
ENVIRONMENT=development
DEBUG=false
DATABASE_PATH=./data/matcher-service.sqlite3
AUTH_JWT_SECRET=replace-with-the-auth-service-signing-secret
ALLOWED_ORIGINS=[]
PAGE_SIZE=15
MAX_PAGE_SIZE=100
TIMEZONE=Europe/Budapest
OMDB_API_URL=https://www.omdbapi.com/
OMDB_API_KEY=
HTTP_TIMEOUT_SECONDS=15
NOTIFICATION_RECIPIENTS=[]
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM_ADDRESS=matcher-service@example.com
MAIL_FROM_NAME=Matcher Service
