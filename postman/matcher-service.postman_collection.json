{
  "info": {"name": "Matcher Service API", "description": "Full Docker E2E endpoint and error coverage using an auth-service JWT.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('health is 200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Missing token 401", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/movies"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing token is rejected', () => pm.response.to.have.status(401));"]}}]},
    {"name": "Invalid token 401", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer invalid"}], "url": "{{baseUrl}}/api/v1/movies"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('invalid token is rejected', () => pm.response.to.have.status(401));"]}}]},
    {"name": "List movies", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=1&size=15"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('movies are listed', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data.length).to.be.greaterThan(0);", "pm.environment.set('movieId', pm.response.json().data[0].uuid);"]}}]},
    {"name": "Movie detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies/{{movieId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('movie detail is returned', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Missing movie 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing movie is rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "Invalid pagination 422", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=0&size=101"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('invalid pagination is rejected', () => pm.response.to.have.status(422));"]}}]},
    {"name": "Empty page", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=2&size=15"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('empty page is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data).to.be.empty;", "pm.expect(pm.response.json().from).to.be.null;", "pm.expect(pm.response.json().to).to.be.null;"]}}]},
    {"name": "List trackers", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('trackers are listed', () => pm.response.to.have.status(200));", "pm.environment.set('trackerId', pm.response.json().data[0].uuid);"]}}]},
    {"name": "Tracker detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('tracker detail is returned', () => pm.response.to.have.status(200));"]}}]},
    {"name": "List rules", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}/rules"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('rules are listed', () => pm.response.to.have.status(200));", "pm.environment.set('ruleId', pm.response.json().data[0].uuid);"]}}]},
    {"name": "Rule detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}/rules/{{ruleId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('rule detail is returned', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Missing tracker 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing tracker is rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "Missing rule 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}/rules/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing rule is rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "List torrents", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/torrents"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('torrents are listed', () => pm.response.to.have.status(200));", "pm.environment.set('torrentId', pm.response.json().data[0].uuid);"]}}]},
    {"name": "Torrent detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/torrents/{{torrentId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('torrent detail is returned', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Missing torrent 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/torrents/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing torrent is rejected', () => pm.response.to.have.status(404));"]}}]}
  ]
