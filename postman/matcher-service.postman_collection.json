{
  "info": {"name": "Matcher Service API", "description": "Full Docker E2E endpoint and error coverage using an auth-service JWT.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('health is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.eql({ status: 'healthy' });", "pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty;"]}}]},
    {"name": "Missing token 401", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/movies"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing token is rejected', () => pm.response.to.have.status(401));"]}}]},
    {"name": "Invalid token 401", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer invalid"}], "url": "{{baseUrl}}/api/v1/movies"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('invalid token is rejected', () => pm.response.to.have.status(401));"]}}]},
    {"name": "Unsupported auth scheme 401", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Basic invalid"}], "url": "{{baseUrl}}/api/v1/movies"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('unsupported auth scheme is rejected', () => pm.response.to.have.status(401));"]}}]},
    {"name": "List movies", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=1&size=15"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('movies are listed', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body).to.have.all.keys('data', 'current_page', 'from', 'last_page', 'per_page', 'to', 'total');", "pm.expect(body.current_page).to.eql(1);", "pm.expect(body.per_page).to.eql(15);", "pm.expect(body.data.length).to.be.greaterThan(0);", "pm.expect(body.data[0]).to.have.property('createdAt');", "pm.expect(body.data[0]).to.have.property('imdbID');", "pm.environment.set('movieId', body.data[0].uuid);"]}}]},
    {"name": "Movie detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies/{{movieId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('movie detail is returned', () => pm.response.to.have.status(200));", "const movie = pm.response.json();", "pm.expect(movie.uuid).to.eql(pm.environment.get('movieId'));", "pm.expect(movie).to.have.property('createdAt');"]}}]},
    {"name": "Missing movie 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing movie is rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "Invalid pagination 422", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=0&size=101"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('invalid pagination is rejected', () => pm.response.to.have.status(422));"]}}]},
    {"name": "Non-numeric pagination 422", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=invalid&size=15"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('non-numeric pagination is rejected', () => pm.response.to.have.status(422));", "pm.expect(pm.response.json().error).to.eql('Validation Error');"]}}]},
    {"name": "Empty page", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/movies?page=2&size=15"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('empty page is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data).to.be.empty;", "pm.expect(pm.response.json().from).to.be.null;", "pm.expect(pm.response.json().to).to.be.null;"]}}]},
    {"name": "List trackers", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('trackers are listed', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.data.length).to.be.greaterThan(0);", "pm.expect(body.data[0]).to.have.property('rules').that.is.an('array');", "pm.environment.set('trackerId', body.data[0].uuid);"]}}]},
    {"name": "Tracker detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('tracker detail is returned', () => pm.response.to.have.status(200));", "const tracker = pm.response.json();", "pm.expect(tracker.uuid).to.eql(pm.environment.get('trackerId'));", "pm.expect(tracker.rules).to.be.an('array');"]}}]},
    {"name": "List rules", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}/rules"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('rules are listed', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.data.length).to.be.greaterThan(0);", "pm.expect(body.data[0]).to.have.all.keys('title', 'uuid', 'value', 'createdAt', 'updatedAt');", "pm.environment.set('ruleId', body.data[0].uuid);"]}}]},
    {"name": "Rule detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}/rules/{{ruleId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('rule detail is returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().uuid).to.eql(pm.environment.get('ruleId')); "]}}]},
    {"name": "Missing tracker 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing tracker is rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "Missing tracker rules 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/missing/rules"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing tracker rules are rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "Missing rule 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/trackers/{{trackerId}}/rules/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing rule is rejected', () => pm.response.to.have.status(404));"]}}]},
    {"name": "List torrents", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/torrents"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('torrents are listed', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.data.length).to.be.greaterThan(0);", "pm.expect(body.data[0]).to.have.property('tracker').that.is.a('string').and.not.empty;", "pm.expect(body.data[0]).to.have.property('movie');", "pm.environment.set('torrentId', body.data[0].uuid);"]}}]},
    {"name": "Torrent detail", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/torrents/{{torrentId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('torrent detail is returned', () => pm.response.to.have.status(200));", "const torrent = pm.response.json();", "pm.expect(torrent.uuid).to.eql(pm.environment.get('torrentId'));", "pm.expect(torrent.tracker).to.be.a('string').and.not.empty;", "pm.expect(torrent.movie).to.be.an('object');"]}}]},
    {"name": "Missing torrent 404", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/v1/torrents/missing"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('missing torrent is rejected', () => pm.response.to.have.status(404));"]}}]}
  ]
